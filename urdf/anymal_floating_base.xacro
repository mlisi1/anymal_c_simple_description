<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="anymal">


    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>


    <xacro:include filename="anymal.urdf.xacro" />

    <link name="floating_base"></link>


    <joint name="virtual" type="floating">
        <parent link="floating_base"/>
        <child link="base"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    
</robot>
